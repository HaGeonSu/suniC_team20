{
  "vendor": "VENDOR_B",
  "icd_version": "1.0",
  "record_type": "CM",
  "metadata_mapping": {
    "ne_id": "managedElement",
    "ne_type": "neType",
    "snapshot_id": "snapshotId"
  },
  "time_mapping": {
    "timestamp_field": "collectTime",
    "raw_format": "yyyy-MM-dd'T'HH:mm:ss'Z' (UTC, convert to KST +09:00)"
  },
  "value_multiplier": {
    "cpuOverloadThreshold": 100
  },
  "parameter_mapping": {
    "sipTimerT1": "sip.timer.t1_ms",
    "sipTimerT2": "sip.timer.t2_ms",
    "sipInviteTimeout": "sip.timer.invite_timeout_ms",
    "regExpire": "registration.expire_sec",
    "maxSessions": "session.max_count",
    "sessionExpire": "session.expire_sec",
    "cpuOverloadThreshold": "overload.cpu_threshold",
    "sipPort": "transport.sip.port",
    "haHeartbeat": "ha.heartbeat_interval_ms",
    "dscpValue": "qos.dscp.value"
  }
}