{
  "vendor": "VENDOR_B",
  "icd_version": "1.0",
  "record_type": "PM",
  "metadata_mapping": {
    "ne_id": "measData/managedElement/@localDn",
    "ne_type": "measData/managedElement/@neType"
  },
  "time_mapping": {
    "timestamp_field": "measInfo/granularityPeriod/@endTime",
    "raw_format": "ISO8601_UTC_Z (e.g. 2026-05-31T15:15:00Z) - convert to KST +09:00",
    "interval_field": "measInfo/granularityPeriod/@duration",
    "interval_unit": "ISO8601_duration (e.g. PT15M -> convert to seconds for granularity_sec)"
  },
  "value_multiplier": {
    "resource.cpu.usage": 100,
    "resource.memory.usage": 100
  },
  "counter_mapping": {
    "VS.RegisterAttempt": "sip.register.attempt",
    "VS.RegisterSuccess": "sip.register.success",
    "VS.RegisterFailure": "sip.register.fail",
    "VS.InviteAttempt": "sip.invite.attempt",
    "VS.InviteSuccess": "sip.invite.success",
    "VS.InviteFailure": "sip.invite.fail",
    "VS.Response4xx": "sip.response.4xx",
    "VS.Response5xx": "sip.response.5xx",
    "VS.Response6xx": "sip.response.6xx",
    "VS.ActiveSessions": "session.active.count",
    "VS.SessionSetupTimeMean": "session.setup.time_ms",
    "VS.CpuUtilRatio": "resource.cpu.usage",
    "VS.MemUtilRatio": "resource.memory.usage",
    "VS.MessagesReceived": "traffic.msg.rx",
    "VS.MessagesSent": "traffic.msg.tx"
  }
}